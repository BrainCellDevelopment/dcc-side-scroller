; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DCC-SideScroller"
run/main_scene="uid://dsypb287qo2hi"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Inventory="*res://scripts/autoload/inventory.gd"
Game="*res://scripts/autoload/game.gd"
PlayerStats="*res://scripts/autoload/player_stats.gd"
SystemVoice="*res://scripts/autoload/system_voice.gd"
DevConsole="*res://scripts/autoload/dev_console.gd"

[gui]

theme/custom="res://assets/ui/theme.tres"
theme/custom_font="res://assets/fonts/PixelifySans.ttf"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/mode=2
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
